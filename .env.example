# MAX Offline Voice-Based AI Assistant Environment Configuration

APP_NAME=MAX
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Whisper Speech-to-Text Configuration
WHISPER_MODEL=base
WHISPER_LANGUAGE=en
WHISPER_DEVICE=cpu

# Ollama Local LLM Configuration
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
REASONING_TEMPERATURE=0.7
CONTEXT_WINDOW_MESSAGES=6

# Piper Text-to-Speech Configuration
PIPER_MODEL_PATH=models/piper/voice.onnx
PIPER_CONFIG_PATH=models/piper/voice.onnx.json
PIPER_VOICE_NAME=en_US-lessac-medium

# Audio Engine & VAD Configuration
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SIZE=1024
VAD_ENERGY_THRESHOLD=0.015
VAD_SILENCE_TIMEOUT=1.2
VAD_SPEECH_PADDING=0.3

# Optional Wake Word
WAKE_WORD="hey max"
WAKE_WORD_ENABLED=false

# Database
DATABASE_PATH=data/max.db
